<resources>
    <!--
      Android 12 and later draw their own splash screen on a cold start and
      ignore android:windowBackground, so the look has to be declared through
      these attributes instead. Same crest, same blue, drawn by the platform.
    -->
    <style name="Theme.ICT361Lab.Splash" parent="Theme.ICT361Lab">
        <item name="android:windowSplashScreenBackground">@color/mu_blue</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/mu_blue</item>
    </style>
</resources>
