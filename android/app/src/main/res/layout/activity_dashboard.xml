cat > android/app/src/main/res/layout/activity_lab_group.xml << 'EOF'
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/my_lab_group"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtGroupLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="G01"
                android:textSize="32sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtOccupancy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Occupancy: 14 / 15"
                android:layout_marginTop="8dp"/>

            <ProgressBar
                android:id="@+id/progressOccupancy"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="15"
                android:progress="14"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GROUP MEMBERS"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMembers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btnRequestChange"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/request_group_change"
        android:layout_marginTop="16dp"/>
</LinearLayout>
