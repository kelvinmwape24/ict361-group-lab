<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground layer.

  The canvas is 108x108dp but a launcher may mask anything outside the centre
  66dp, so every drawn element sits between 21 and 87 on both axes.

  The glyph is a roster: three record rows and a tick, which is what the app is.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Row 1 -->
    <path android:fillColor="#FFFFFF" android:pathData="M32,38m-5,0a5,5 0 1,0 10,0a5,5 0 1,0 -10,0" />
    <path android:fillColor="#FFFFFF" android:pathData="M44,35h33v6h-33z" />

    <!-- Row 2 -->
    <path android:fillColor="#FFFFFF" android:pathData="M32,54m-5,0a5,5 0 1,0 10,0a5,5 0 1,0 -10,0" />
    <path android:fillColor="#FFFFFF" android:pathData="M44,51h33v6h-33z" />

    <!-- Row 3, dimmed: the record still syncing -->
    <path android:fillColor="#FFFFFF" android:fillAlpha="0.55" android:pathData="M32,70m-5,0a5,5 0 1,0 10,0a5,5 0 1,0 -10,0" />
    <path android:fillColor="#FFFFFF" android:fillAlpha="0.55" android:pathData="M44,67h22v6h-22z" />
</vector>
